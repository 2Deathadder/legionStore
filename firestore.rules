rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasAll(['name','email','items','total','status']) && request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasAll(['name','email','message']);
      allow read, update, delete: if isAdmin();
    }
  }
}